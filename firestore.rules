rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chiunque apra l'app (accesso anonimo) può leggere e scrivere i dati del gruppo.
    match /groups/{group}/{collection}/{docId} {
      allow read, write: if request.auth != null
        && collection in ['people', 'trips'];
    }
  }
}
